{% comment %}
  Promo Feature Section
  - Fully editable from Theme Editor (no hard-coded content)
  - Settings: heading, description, image, button text, button url, alignment
{% endcomment %}

<div class="promo-feature-{{ section.id }} page-width">
  <div class="promo-feature__row promo-feature__row--{{ section.settings.image_alignment }}">

    <div class="promo-feature__media">
      {% if section.settings.image != blank %}
        <img
          src="{{ section.settings.image | image_url: width: 800 }}"
          srcset="{{ section.settings.image | image_url: width: 400 }} 400w,
                  {{ section.settings.image | image_url: width: 800 }} 800w,
                  {{ section.settings.image | image_url: width: 1200 }} 1200w"
          sizes="(min-width: 750px) 50vw, 100vw"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
          loading="lazy"
        >
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'promo-feature__placeholder' }}
      {% endif %}
    </div>

    <div class="promo-feature__content">
      {% if section.settings.heading != blank %}
        <h2 class="promo-feature__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="promo-feature__description">{{ section.settings.description }}</div>
      {% endif %}

      {% if section.settings.button_text != blank %}
        <a
          {% if section.settings.button_url != blank %}
            href="{{ section.settings.button_url }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
          class="promo-feature__button button"
        >
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>

  </div>
</div>

{% style %}
  .promo-feature-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .promo-feature-{{ section.id }} .promo-feature__row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 40px;
  }

  .promo-feature-{{ section.id }} .promo-feature__row--right {
    flex-direction: row-reverse;
  }

  .promo-feature-{{ section.id }} .promo-feature__row--center {
    flex-direction: column;
    text-align: center;
  }

  .promo-feature-{{ section.id }} .promo-feature__media,
  .promo-feature-{{ section.id }} .promo-feature__content {
    flex: 1 1 400px;
  }

  .promo-feature-{{ section.id }} .promo-feature__row--center .promo-feature__media,
  .promo-feature-{{ section.id }} .promo-feature__row--center .promo-feature__content {
    flex: 1 1 100%;
    max-width: 700px;
    margin: 0 auto;
  }

  .promo-feature-{{ section.id }} .promo-feature__media img,
  .promo-feature-{{ section.id }} .promo-feature__placeholder {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 8px;
  }

  .promo-feature-{{ section.id }} .promo-feature__heading {
    margin: 0 0 12px 0;
    font-size: 32px;
    line-height: 1.2;
  }

  .promo-feature-{{ section.id }} .promo-feature__description {
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .promo-feature-{{ section.id }} .promo-feature__button {
    display: inline-block;
    text-decoration: none;
    padding: 12px 28px;
    border: 1px solid;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .promo-feature-{{ section.id }} .promo-feature__button:hover {
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .promo-feature-{{ section.id }} .promo-feature__row,
    .promo-feature-{{ section.id }} .promo-feature__row--right {
      flex-direction: column;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Promo Feature",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Feature heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Describe the feature or promotion here.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "select",
      "id": "image_alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Image left" },
        { "value": "right", "label": "Image right" },
        { "value": "center", "label": "Centered (stacked)" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Promo Feature"
    }
  ]
}
{% endschema %}
