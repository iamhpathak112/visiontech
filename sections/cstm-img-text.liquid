<div class="wrapper-{{ section.id }} {% if section.settings.vertical_alignment == 'con' %}page-width{% endif %}">
  {% if section.blocks.size > 0 %}
    {% for block in section.blocks %}
      <div class="row row--{{ section.settings.logo_aligment }}" {{ block.shopify_attributes }}>
        {% if block.settings.img != blank %}
          <div class="about_img">
            <img
              src="{{ block.settings.img | image_url: width: 800 }}"
              srcset="{{ block.settings.img | image_url: width: 400 }} 400w,
                      {{ block.settings.img | image_url: width: 800 }} 800w,
                      {{ block.settings.img | image_url: width: 1200 }} 1200w"
              sizes="(min-width: 750px) 50vw, 100vw"
              width="{{ block.settings.img.width }}"
              height="{{ block.settings.img.height }}"
              alt="{{ block.settings.img.alt | default: block.settings.heading | escape }}"
              loading="lazy"
            >
          </div>
        {% endif %}

        <div class="about_content">
          {% if block.settings.heading != blank %}
            <h2>{{ block.settings.heading }}</h2>
          {% endif %}
          {% if block.settings.para != blank %}
            <p>{{ block.settings.para }}</p>
          {% endif %}
          {% if block.settings.anchor != blank and block.settings.link != blank %}
            <div class="view_anchor">
              <a href="{{ block.settings.link }}">{{ block.settings.anchor }}</a>
            </div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  {% else %}
    <div class="about_placeholder">
      {{ 'onboarding.default_text' | placeholder_svg_tag: 'placeholder-svg' }}
      <p>Add a block to get started.</p>
    </div>
  {% endif %}
</div>

{% style %}
  .wrapper-{{ section.id }} {
    padding-top: {{ section.settings.pd_top }}px;
    padding-bottom: {{ section.settings.pd_bottom }}px;
    margin-bottom: {{ section.settings.magn_bottom }}px;
    {% if section.settings.bg-image != blank %}
      background-image: url('{{ section.settings.bg-image | image_url: width: 1800 }}');
      background-size: cover;
      background-position: center;
    {% endif %}
  }

  .wrapper-{{ section.id }} .row {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 30px;
  }

  .wrapper-{{ section.id }} .row--right {
    flex-direction: row-reverse;
  }

  .wrapper-{{ section.id }} .about_img {
    flex: 1 1 400px;
    max-width: calc(50% - 20px);
  }

  .wrapper-{{ section.id }} .about_img img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid;
    border-radius: 9px;
  }

  .wrapper-{{ section.id }} .about_content {
    flex: 1 1 300px;
    max-width: 50%;
  }

  .wrapper-{{ section.id }} .about_content h2 {
    margin: 10px 0 0 0;
    font-size: {{ section.settings.font_size }}px;
    text-transform: {{ section.settings.Text-Transform }};
  }

  .wrapper-{{ section.id }} .about_content p {
    font-size: 18px;
    margin: 10px 0;
  }

  .wrapper-{{ section.id }} .view_anchor {
    text-align: center;
  }

  .wrapper-{{ section.id }} .view_anchor a {
    display: inline-block;
    text-decoration: none;
    text-transform: capitalize;
    color: #000;
    background: #fff;
    margin: 20px 0;
    text-align: center;
    width: 100px;
    height: 45px;
    line-height: 45px;
    border: 1px solid;
    border-radius: 5px;
    transition: all 0.3s linear;
  }

  .wrapper-{{ section.id }} .view_anchor a:hover {
    color: #fff;
    background: #000;
  }

  @media screen and (max-width: 749px) {
    .wrapper-{{ section.id }} .about_img,
    .wrapper-{{ section.id }} .about_content {
      max-width: 100%;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "about_us",
  "settings": [
    {
      "type": "select",
      "id": "Text-Transform",
      "label": "Heading text transform",
      "options": [
        { "value": "lowercase", "label": "Lowercase" },
        { "value": "capitalize", "label": "Capitalize" },
        { "value": "uppercase", "label": "Uppercase" }
      ],
      "default": "lowercase"
    },
    {
      "type": "radio",
      "id": "logo_aligment",
      "label": "Image alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "bg-image",
      "label": "Custom background image"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Heading font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "pd_top",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Padding top",
      "default": 14
    },
    {
      "type": "range",
      "id": "pd_bottom",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Padding bottom",
      "default": 14
    },
    {
      "type": "range",
      "id": "magn_bottom",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Margin bottom",
      "default": 14
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Container width",
      "options": [
        { "value": "con", "label": "Contained" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "con"
    }
  ],
  "blocks": [
    {
      "type": "gallary",
      "name": "About block",
      "settings": [
        { "type": "image_picker", "id": "img", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "para", "label": "Paragraph" },
        { "type": "url", "id": "link", "label": "Button link" },
        { "type": "text", "id": "anchor", "label": "Button label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "about_us",
      "blocks": [{ "type": "gallary" }]
    }
  ]
}
{% endschema %}
